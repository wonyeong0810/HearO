# ============================================================================
# HearO — 환경변수 템플릿
# ============================================================================
# 사용법:
#   cp .env.example .env
#   그리고 아래 <FILL_ME> 자리를 실제 값으로 채우세요.
#
# .env 는 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. OpenAI — STT (실시간 전사 + 화자분리)
# ----------------------------------------------------------------------------
# 발급: https://platform.openai.com/api-keys
# 필요 권한: Model capabilities → Audio(transcriptions), Realtime
#
# HearO 는 이 키로 아래 2가지를 호출합니다.
#   1) gpt-live-transcribe        — 실시간 스트리밍 자막   ($0.017 / 분)
#   2) gpt-4o-transcribe-diarize  — 화자분리 확정          ($2.5 / 1M in tok)
#
# 감정·톤 분류는 더 이상 여기 있지 않습니다. 아래 1-B 를 보세요.
#
# ⚠️ 조직(Organization) 단위로 Realtime API 접근이 열려 있어야 합니다.
#    Settings → Limits 에서 "Realtime" 사용 가능 여부를 확인하세요.
OPENAI_API_KEY=<FILL_ME>

# (선택) 여러 조직/프로젝트를 쓰는 경우에만 지정. 아니면 비워두세요.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# 모델 핀 고정 — OpenAI 모델 은퇴(retirement) 시 여기만 바꾸면 됩니다.
# gpt-4o-transcribe / whisper-1 계열은 2026-06 은퇴했으므로 사용하지 않습니다.
OPENAI_REALTIME_MODEL=gpt-live-transcribe
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize

# 전사 언어 힌트 (ISO-639-1, 쉼표 구분). 한국어+영어 코드스위칭 대비.
STT_LANGUAGE_HINTS=ko,en

# 도메인 고유명사 인식률을 올리는 키워드 힌트 (쉼표 구분, 선택)
STT_KEYWORD_HINTS=


# ----------------------------------------------------------------------------
# 1-B. 감정·톤 분류 LLM — 기본값 DeepSeek V4 Flash
# ----------------------------------------------------------------------------
# 발급: https://platform.deepseek.com/api_keys
#
# STT 와 제공자를 분리했습니다. 실시간 전사·화자분리는 OpenAI 고유 기능이라
# 옮길 수 없지만, 감정 분류는 평범한 chat completions 라 더 싸고 빠른 모델을
# 쓸 수 있습니다. (V4 Flash: $0.14 / 1M 입력, $0.28 / 1M 출력)
EMOTION_API_KEY=<FILL_ME>

# OpenAI 호환 엔드포인트입니다. 다른 제공자로 바꾸려면 이 둘만 바꾸면 됩니다.
EMOTION_BASE_URL=https://api.deepseek.com/v1
EMOTION_MODEL=deepseek-v4-flash

# 이 시간 안에 답이 없으면 운율(음량·피치·속도) 추정으로 넘어갑니다.
# 자막은 실시간이라 길게 잡으면 이미 지나간 말의 감정이 뒤늦게 덮어써집니다.
EMOTION_TIMEOUT_SECONDS=4.0

# DeepSeek V4 는 사고(thinking) 모드가 기본 켜짐입니다. 켜두면 첫 토큰까지
# 수 초가 걸려 위 타임아웃을 매번 넘기고, 감정이 전부 운율 추정으로 떨어집니다.
# ⚠️ EMOTION_BASE_URL 을 OpenAI 등 이 파라미터를 모르는 곳으로 바꾸면
#    400 이 나므로, 그때는 false 로 두세요.
EMOTION_DISABLE_THINKING=true


# ----------------------------------------------------------------------------
# 2. 데이터베이스 (PostgreSQL)
# ----------------------------------------------------------------------------
# docker-compose 로 띄우면 아래 기본값 그대로 동작합니다.
# 운영 배포 시에는 관리형 DB(RDS/Cloud SQL/Supabase) URL 로 교체하세요.
POSTGRES_USER=hearo
POSTGRES_PASSWORD=<FILL_ME>
POSTGRES_DB=hearo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 위 값들로 자동 조립되지만, 직접 지정하면 이 값이 우선합니다.
# 반드시 asyncpg 드라이버를 사용하세요: postgresql+asyncpg://...
DATABASE_URL=


# ----------------------------------------------------------------------------
# 3. Redis — 리프레시 토큰 폐기목록, 레이트리밋, 라이브 세션 상태
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0


# ----------------------------------------------------------------------------
# 4. 인증 / 보안
# ----------------------------------------------------------------------------
# 아래 명령으로 생성하세요 (64자 hex):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<FILL_ME>

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

# 앱에서 접근을 허용할 오리진 (쉼표 구분).
# 모바일 앱만 쓴다면 그대로 두고, 웹 대시보드를 붙이면 도메인을 추가하세요.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 신뢰할 호스트 헤더 (쉼표 구분). 운영 도메인으로 교체하세요.
ALLOWED_HOSTS=*


# ----------------------------------------------------------------------------
# 5. 푸시 알림 (선택) — 경보 감지는 온디바이스라 푸시 없이도 동작합니다.
#    백그라운드 종료 상태에서의 보조 알림 채널이 필요할 때만 설정하세요.
# ----------------------------------------------------------------------------
# 발급: Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# 다운받은 JSON 파일의 "경로"를 지정합니다. (JSON 내용을 그대로 넣지 마세요)
FIREBASE_CREDENTIALS_PATH=
FCM_ENABLED=false


# ----------------------------------------------------------------------------
# 6. 오디오 파이프라인 튜닝
# ----------------------------------------------------------------------------
# 클라이언트가 올려보내는 PCM 규격. 변경 시 Flutter 쪽 상수도 함께 바꿔야 합니다.
AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1

# 화자분리 트랙이 오디오를 잘라 보내는 창 길이(초).
# 짧을수록 화자 라벨이 빨리 붙지만 API 호출 비용/오탐이 늘어납니다.
# 권장 8~15초. 30초를 넘기면 chunking_strategy 가 강제됩니다.
DIARIZE_WINDOW_SECONDS=12
DIARIZE_WINDOW_OVERLAP_SECONDS=2

# 세션 내 화자 동일성 유지를 위한 참조 클립.
# OpenAI 제약: 최대 4명, 각 2~10초.
SPEAKER_REFERENCE_MAX=4
SPEAKER_REFERENCE_MIN_SECONDS=2.0
SPEAKER_REFERENCE_MAX_SECONDS=8.0

# 무음 판정 임계값(dBFS). 이보다 조용하면 diarize 호출을 건너뛰어 비용을 아낍니다.
SILENCE_THRESHOLD_DBFS=-45.0


# ----------------------------------------------------------------------------
# 7. 로그 보관 정책
# ----------------------------------------------------------------------------
# 사용자가 앱에서 개별 설정할 수 있으며, 아래는 신규 가입자 기본값입니다.
# 0 = 무기한 보관 (자동 삭제 안 함)
DEFAULT_LOG_RETENTION_DAYS=90

# 자동 삭제 워커 실행 주기(초). 기본 6시간.
RETENTION_SWEEP_INTERVAL_SECONDS=21600


# ----------------------------------------------------------------------------
# 8. 레이트리밋
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# 라이브 세션은 사용자당 동시 N개까지만 허용 (비용 폭주 방지)
MAX_CONCURRENT_LIVE_SESSIONS_PER_USER=2


# ----------------------------------------------------------------------------
# 9. 런타임
# ----------------------------------------------------------------------------
# local | staging | production
ENVIRONMENT=local
# production 에서는 반드시 false (에러 상세가 클라이언트로 노출됨)
DEBUG=true
LOG_LEVEL=INFO
# JSON 구조화 로그. production 권장 true
LOG_JSON=false

API_HOST=0.0.0.0
API_PORT=8000

# (선택) Sentry DSN — 넣으면 에러 리포팅이 켜집니다.
SENTRY_DSN=
